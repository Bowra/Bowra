# Bowra Community local source configuration. Copy to .env and keep it private.
# Run commands from the repository root so relative storage paths are stable.
BOWHEAD_ENV=prod
BOWHEAD_AUTH_MODE=prod
BOWHEAD_DEPLOYMENT_MODE=local
BOWHEAD_DB_URL=sqlite+aiosqlite:///.data/sqlite/bowhead.db
# Keep deletion receipts durable; never restore an older ledger with an older app DB.
BOWHEAD_PRIVACY_LEDGER_DB=.data/privacy-ledger/deletions.db

# Generate once per installation. Preserve both keys with database/object backups.
BOWHEAD_FERNET_KEY=
BOWHEAD_JWT_SECRET=

# Serve the locally built default-English frontend from the gateway.
BOWHEAD_FRONTEND_STATIC_DIR=packages/bowhead_frontend/out

# Required before Gateway startup: a reachable, compatible sandbox executor.
# Obtain its external credential from the executor operator; keep it private.
BOWHEAD_SANDBOX_EXECUTOR_URL=
BOWHEAD_SANDBOX_EXECUTOR_TOKEN=
# Configure an absolute shared writable root at the SAME path for Gateway,
# executor and its Docker host before running sandbox-backed workflows.
BOWHEAD_SKILL_WORKDIR_ROOT=

# Match these callback addresses to the local Gateway port if it changes.
BOWHEAD_GATEWAY_URL=http://127.0.0.1:8080
BOWHEAD_EXPORT_FRONTEND_BASE_URL=http://127.0.0.1:8080

# Model, data, mail and MCP credentials are configured after first-owner setup.
# Review runtime components and validate execution/output collection separately.
