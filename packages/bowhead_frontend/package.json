{
  "name": "bowhead-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Bowhead — Verified Intelligence frontend (Next.js 15)",
  "scripts": {
    "dev": "next dev --port 3000",
    "prebuild": "npm run assemble && node scripts/copy-legal-notices.mjs",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit --project tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:homepage": "CI=1 PLAYWRIGHT_WORKERS=1 playwright test e2e/homepage-visual.spec.ts",
    "test:e2e:smoke": "playwright test e2e/*smoke.spec.ts",
    "test:e2e:legacy": "BOWHEAD_E2E_PROFILE=legacy playwright test",
    "test:e2e:live": "BOWHEAD_E2E_PROFILE=live playwright test",
    "test:e2e:sse": "BOWHEAD_E2E_PROFILE=sse playwright test",
    "test:e2e:all": "BOWHEAD_E2E_PROFILE=all playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "assemble": "node scripts/assemble-edition.mjs",
    "predev": "npm run assemble",
    "pretypecheck": "npm run assemble",
    "pretest": "npm run assemble",
    "pretest:watch": "npm run assemble",
    "pretest:e2e": "npm run assemble"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@floating-ui/react": "^0.27.19",
    "@swc/helpers": "^0.5.21",
    "@tanstack/react-virtual": "^3.14.6",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-font-family": "3.32.0",
    "@tiptap/extension-link": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extension-table-cell": "3.32.0",
    "@tiptap/extension-table-header": "3.32.0",
    "@tiptap/extension-table-row": "3.32.0",
    "@tiptap/extension-text-style": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@types/dompurify": "^3.0.5",
    "acorn": "8.16.0",
    "chart.js": "^4.5.1",
    "chartjs-chart-matrix": "^3.0.4",
    "chartjs-chart-sankey": "^0.14.3",
    "chartjs-plugin-datalabels": "^2.2.0",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "framer-motion": "^11.11.0",
    "katex": "^0.16.47",
    "lucide-react": "1.49.0",
    "mammoth": "~1.12.3",
    "markdown-it": "^14.3.3",
    "mermaid": "^11.17.2",
    "next": "~15.5.28",
    "next-intl": "^4.9.2",
    "parse5": "8.0.1",
    "pdfjs-dist": "^6.4.299",
    "playwright": "1.59.1",
    "prosemirror-markdown": "^1.13.4",
    "react": "~19.2.9",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "~19.2.9",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.0.0",
    "unified": "^11.0.0",
    "use-intl": "^4.11.0"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@tailwindcss/postcss": "^4.0.0-beta.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "axe-core": "^4.11.3",
    "eslint": "^9.16.0",
    "eslint-config-next": "~15.5.28",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.0.0-beta.6",
    "typescript": "^5.6.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "mammoth": {
      "@xmldom/xmldom": "0.8.15"
    },
    "postcss": "8.5.32"
  }
}
