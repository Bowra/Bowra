{
  "extends": "./tsconfig.json",
  "include": [
    "next-env.d.ts",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/__tests__/**/*.ts",
    "**/__tests__/**/*.tsx",
    "**/__mocks__/**/*.ts",
    "**/__mocks__/**/*.tsx",
    "e2e/**/*.ts",
    "e2e/**/*.tsx",
    "vitest*.ts",
    "playwright*.ts"
  ],
  "exclude": ["node_modules"]
}
