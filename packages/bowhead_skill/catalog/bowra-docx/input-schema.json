{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "operation": {
          "const": "create"
        },
        "title": {
          "type": "string",
          "maxLength": 200,
          "minLength": 1
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "heading"
                  },
                  "text": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "level": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 6
                  }
                },
                "required": [
                  "type",
                  "text",
                  "level"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "paragraph"
                  },
                  "text": {
                    "type": "string",
                    "maxLength": 4000
                  }
                },
                "required": [
                  "type",
                  "text"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "bullets"
                  },
                  "items": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 30,
                    "items": {
                      "type": "string",
                      "maxLength": 1000
                    }
                  }
                },
                "required": [
                  "type",
                  "items"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "table"
                  },
                  "columns": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 8,
                    "items": {
                      "type": "string",
                      "maxLength": 200
                    }
                  },
                  "rows": {
                    "type": "array",
                    "maxItems": 100,
                    "items": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 8,
                      "items": {
                        "type": "string",
                        "maxLength": 1000
                      }
                    }
                  }
                },
                "required": [
                  "type",
                  "columns",
                  "rows"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": [
        "operation",
        "title",
        "blocks"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "operation": {
          "const": "inspect"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "operation",
        "source"
      ],
      "additionalProperties": false
    }
  ]
}
