{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "operation": {
          "const": "create"
        },
        "title": {
          "type": "string",
          "maxLength": 200,
          "minLength": 1
        },
        "slides": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "maxLength": 80,
                    "minLength": 1
                  },
                  "bullets": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 6,
                    "items": {
                      "type": "string",
                      "maxLength": 180
                    }
                  }
                },
                "required": [
                  "title",
                  "bullets"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "maxLength": 80,
                    "minLength": 1
                  },
                  "columns": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 6,
                    "items": {
                      "type": "string",
                      "maxLength": 60
                    }
                  },
                  "rows": {
                    "type": "array",
                    "maxItems": 7,
                    "items": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 6,
                      "items": {
                        "type": "string",
                        "maxLength": 60
                      }
                    }
                  }
                },
                "required": [
                  "title",
                  "columns",
                  "rows"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": [
        "operation",
        "title",
        "slides"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "operation": {
          "const": "inspect"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "operation",
        "source"
      ],
      "additionalProperties": false
    }
  ]
}
